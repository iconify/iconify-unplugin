{
	"name": "@iconify/unplugin",
	"type": "module",
	"version": "0.1.5",
	"packageManager": "pnpm@10.34.1",
	"description": "Icon components on demand",
	"author": "Vjacheslav Trushkin <cyberalien@gmail.com> (https://cyberalien.dev/)",
	"funding": "https://github.com/sponsors/cyberalien",
	"license": "MIT",
	"bugs": "https://github.com/iconify/iconify-unplugin/issues",
	"homepage": "https://iconify.design/",
	"repository": {
		"type": "git",
		"url": "https://github.com/iconify/iconify-unplugin.git"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		},
		"./astro": {
			"import": "./dist/astro.mjs",
			"require": "./dist/astro.cjs"
		},
		"./esbuild": {
			"import": "./dist/esbuild.mjs",
			"require": "./dist/esbuild.cjs"
		},
		"./farm": {
			"import": "./dist/farm.mjs",
			"require": "./dist/farm.cjs"
		},
		"./nuxt": {
			"import": "./dist/nuxt.mjs",
			"require": "./dist/nuxt.cjs"
		},
		"./rollup": {
			"import": "./dist/rollup.mjs",
			"require": "./dist/rollup.cjs"
		},
		"./rspack": {
			"import": "./dist/rspack.mjs",
			"require": "./dist/rspack.cjs"
		},
		"./types": {
			"import": "./dist/types.mjs",
			"require": "./dist/types.cjs"
		},
		"./vite": {
			"import": "./dist/vite.mjs",
			"require": "./dist/vite.cjs"
		},
		"./webpack": {
			"import": "./dist/webpack.mjs",
			"require": "./dist/webpack.cjs"
		},
		"./types/preact": {
			"types": "./types/preact.d.ts"
		},
		"./types/raw": {
			"types": "./types/raw.d.ts"
		},
		"./types/react": {
			"types": "./types/react.d.ts"
		},
		"./types/svelte": {
			"types": "./types/svelte.d.ts"
		},
		"./types/vue": {
			"types": "./types/vue.d.ts"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"*.d.ts",
		"dist",
		"types"
	],
	"scripts": {
		"build": "tsdown",
		"test": "vitest",
		"lint": "oxlint --type-aware --type-check",
		"lint:fix": "oxlint --type-aware --type-check --fix"
	},
	"dependencies": {
		"@cyberalien/svg-utils": "^1.2.15",
		"@iconify/types": "^2.0.0",
		"local-pkg": "^1.2.1",
		"unplugin": "^3.0.0"
	},
	"devDependencies": {
		"@types/jest": "^30.0.0",
		"@types/node": "^25.9.1",
		"oxlint": "^1.67.0",
		"oxlint-tsgolint": "^0.15.0",
		"tsdown": "^0.20.3",
		"typescript": "^5.9.3",
		"vitest": "^4.1.7"
	}
}
